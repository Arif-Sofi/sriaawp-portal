# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is git-ignored.

# Supabase — public client (browser-safe). Used by @supabase/supabase-js.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase — service role (server-only). Bypasses RLS; never expose to the browser.
# Also used server-side to mint short-lived signed URLs for internal Mode-3
# manual screenshots (src/lib/storage/manual-images.ts, issue #81).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Mode-3 manual images (issue #81/#89): created via the Storage API/dashboard,
# NOT a SQL migration. Bucket names are constants in manual-images.ts:
#   manual-images-public   (PUBLIC)  — anonymously fetchable public-safe screenshots
#   manual-images-internal (PRIVATE) — served via signed URLs after a visibility check

# Auth.js v5 — generate with: npx auth secret
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="generate-via-npx-auth-secret"

# Auth.js v5 — base URL for callbacks. Override per environment.
AUTH_URL="http://localhost:3000"

# Resend (magic-link delivery). Sign up at https://resend.com,
# add and verify the SRIAAWP domain, then create an API key.
# Leave blank in development — auth.ts falls back to console.log of the magic link.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="SRIAAWP <no-reply@sriaawp.edu.my>"

# Supabase Auth (ADR-018) handles magic-link/OTP and Google OAuth. Email
# delivery is built into Supabase; OTP/magic-link branding and Google OAuth are
# Supabase-dashboard wiring steps, not env vars. Optional custom-SMTP branding
# (e.g. Resend) is configured in the Supabase dashboard, not here.

# Gemini API key (Vercel AI SDK + @ai-sdk/google).
# Used by both embedding pipeline (ADR-006) and chat LLM (ADR-007).
# Free tier for FYP1/FYP2 dev with synthetic data; paid tier required for production
# with real student data per ADR-008 (PDPA: opt out of model training).
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# Postgres connection string used by the application at runtime (Drizzle, via
# the service-role connection). On Supabase, point this at the Transaction Pooler
# (port 6543) so serverless connections reuse a pool. Local Supabase default
# below targets the direct port — fine for development.
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:54322/postgres"

# Direct (non-pooled) connection string used by drizzle-kit migrations and
# the seed script. On hosted Supabase this is port 5432; locally it is the
# same as DATABASE_URL.
DATABASE_URL_DIRECT=""

# 32-byte symmetric key used by pgcrypto's pgp_sym_encrypt to column-encrypt
# student IC numbers (ADR-008 PDPA). Rotate with re-encryption job; never log.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
IC_ENCRYPTION_KEY="replace-me-with-a-32-byte-base64-string"

# Facebook Page outbound sync (ADR-022, spike #84). Selects which FacebookClient
# getFacebookClient() returns. MOCK-FIRST: leave at "mock" for all FYP1/FYP2
# development and CI — the MockFacebookClient never calls the network.
#   mock  -> MockFacebookClient  (default; deterministic synthetic objectIds)
#   real  -> RealFacebookClient  (production turn-on step; currently a throwing stub)
# Flipping to "real" is gated on the SCHOOL owning the Meta app and completing
# App Review (pages_manage_posts) + Business Verification (R-13). The long-lived
# PAGE access token is then stored pgcrypto-encrypted (ADR-008/ADR-016), NOT here.
FACEBOOK_CLIENT="mock"

# 32-byte symmetric key used by pgcrypto's pgp_sym_encrypt to column-encrypt the
# long-lived Facebook Page access token in fb_credential (ADR-022/ADR-008/ADR-016),
# mirroring IC_ENCRYPTION_KEY. Rotate with a re-encryption job; never log. The MOCK
# path never reads or networks the token, so a dev value is fine for FYP1/FYP2.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FACEBOOK_TOKEN_KEY="replace-me-with-a-32-byte-base64-string"

# Shared secret protecting the Facebook outbox drain Route Handler
# (POST /api/jobs/facebook-outbox) when triggered by a Vercel cron. A request
# carrying this value in the Authorization: Bearer header may drain the outbox;
# an authenticated admin holding news:sync_facebook may also trigger it.
CRON_SECRET="replace-me-with-a-random-secret"
